msgstr "Проверить подключение"

msgid "Test webhook with demo data"
msgstr "Проверить вебхук тестовыми данными"

msgid "Thank you for your order."
msgstr "Спасибо за ваш заказ."

msgid "The CUPS certificate bundle is unavailable."
msgstr "Набор сертификатов CUPS недоступен."

msgid "The CUPS password is managed with WCIP_CUPS_PASSWORD and cannot be edited here."
msgstr "Пароль CUPS управляется через WCIP_CUPS_PASSWORD и здесь не редактируется."

msgid "The CUPS request could not be completed. Check the server and paper output before reprinting."
msgstr "Запрос CUPS не завершён. Проверьте сервер и бумагу перед повтором."

msgid "The CUPS server rejected the request or returned an uncertain result."
msgstr "Сервер CUPS отклонил запрос или вернул неопределённый результат."

msgid "The background queue is unavailable."
msgstr "Фоновая очередь недоступна."

msgid "The document exceeds the safe rendering limit."
msgstr "Документ превышает безопасный предел обработки."

msgid "The invoice could not be prepared. Review Print Jobs before trying again."
msgstr "Не удалось подготовить счёт. Проверьте задания печати перед повторной попыткой."

msgid "The invoice printer database could not be installed. Check database permissions and try activation again."
msgstr "Не удалось установить базу данных печати счетов. Проверьте права доступа к базе данных и повторите активацию."

msgid "The invoice will be queued for the configured physical printer."
msgstr "Счёт будет добавлен в очередь настроенного физического принтера."

msgid "The operation could not complete. Check permissions, input and configuration, then review diagnostics."
msgstr "Операция не завершена. Проверьте права, ввод и настройки, затем диагностику."

msgid "The order is no longer paid, so automatic printing was stopped."
msgstr "Заказ больше не считается оплаченным, поэтому автоматическая печать остановлена."

msgid "The order no longer exists."
msgstr "Заказ больше не существует."

msgid "The print confirmation could not be saved. Review Print Jobs and try again."
msgstr "Не удалось сохранить подтверждение печати. Проверьте задания печати и повторите попытку."

msgid "The print document or copy count is invalid."
msgstr "Документ или число копий недопустимы."

msgid "The print job could not be queued."
msgstr "Не удалось добавить задание печати в очередь."

msgid "The print job could not be queued. Review Print Jobs before trying again."
msgstr "Не удалось добавить задание печати в очередь. Проверьте задания печати перед повторной попыткой."

msgid "The print job could not be saved."
msgstr "Не удалось сохранить задание печати."

msgid "The print operation failed. Check the configuration and try again."
msgstr "Операция печати не удалась. Проверьте настройки и повторите попытку."

msgid "The print request stopped. Review Print Jobs before trying again."
msgstr "Запрос печати остановлен. Проверьте задания печати перед повторной попыткой."

msgid "The printing configuration migration failed. Check database permissions."
msgstr "Перенос настроек печати не удался. Проверьте права базы данных."

msgid "The provider accepted the print job, but its result could not be saved. Check CUPS before reprinting."
msgstr "Провайдер принял задание печати, но результат не удалось сохранить. Проверьте CUPS перед повторной печатью."

msgid "The selected printer is invalid."
msgstr "Выбранный принтер некорректен."

msgid "The stored password is never displayed or returned to the browser."
msgstr "Сохранённый пароль никогда не показывается и не возвращается браузеру."

msgid "The worker stopped before recording a result. Check CUPS before reprinting."
msgstr "Обработчик остановился до записи результата. Проверьте CUPS перед повторной печатью."

msgid "Thermal 58 mm"
msgstr "Термочек 58 мм"

msgid "Thermal 80 mm"
msgstr "Термопечать 80 мм"

msgid "This job is not eligible for a safe retry. Reprint intentionally instead."
msgstr "Безопасная повторная попытка для этого задания невозможна. При необходимости осознанно создайте новое задание печати."

msgid "This list contains queues shared by your CUPS server. Configure and test the printer in CUPS, save its HTTPS address here, then refresh."
msgstr "Список общих очередей сервера CUPS. Настройте и проверьте принтер в CUPS, сохраните HTTPS-адрес и обновите список."

msgid "This order does not require a shipping label."
msgstr "Этому заказу не нужна транспортная этикетка."

msgid "This order is not eligible under the configured payment policy."
msgstr "Заказ не соответствует настроенной политике оплаты."

msgid "To"
msgstr "По"

msgid "Total"
msgstr "Итого"

msgid "Total:"
msgstr "Итого:"

msgid "Trigger"
msgstr "Событие запуска"

msgid "Unit"
msgstr "Цена за единицу"

msgid "Unit prices and discounts exclude tax; line totals include tax."
msgstr "Цены за единицу и скидки указаны без налога; суммы строк включают налог."

msgid "Unit prices exclude tax; line totals include discounts and tax."
msgstr "Цены за единицу указаны без налога; суммы строк включают скидки и налог."

msgid "Unknown"
msgstr "Неизвестно"

msgid "Update fulfillment"
msgstr "Обновить выполнение"

msgid "Updated"
msgstr "Обновлено"

msgid "Use a keyboard scanner or enter the opaque reference. Scanning requires sign-in and never confirms physical printing."
msgstr "Используйте клавиатурный сканер или введите код. Нужен вход; сканирование не подтверждает печать на бумаге."

msgid "Use a printer installed on this computer through your browser. No account or subscription is needed."
msgstr "Используйте установленный на компьютере принтер через браузер. Учётная запись и подписка не нужны."

msgid "Use billing values for missing recipient fields"
msgstr "Использовать платёжный адрес для пустых полей получателя"

msgid "Use site or an IANA timezone. Map named fields to trusted order metadata keys. Extra address fields are printed only when mapped."
msgstr "Укажите site или пояс IANA. Сопоставьте поля с доверенными метаданными заказа. Дополнительные поля адреса печатаются только при сопоставлении."

msgid "Use the free local print agent on Windows, Linux or macOS. It connects to this site over HTTPS and works with shared hosting, VPS and dedicated servers."
msgstr "Используйте бесплатный локальный агент в Windows, Linux или macOS. Он подключается к сайту по HTTPS и работает с общим хостингом, VPS и выделенными серверами."

msgid "View"
msgstr "Просмотр"

msgid "Weight"
msgstr "Вес"

msgid "Weight in kg"
msgstr "Вес в кг"

msgid "WooCommerce Invoice Printer"
msgstr "Печать счетов WooCommerce"

msgid "WooCommerce Invoice Printer could not prepare its database. Printing is unavailable; check database permissions and reactivate the plugin."
msgstr "Не удалось подготовить базу данных печати счетов WooCommerce. Печать недоступна; проверьте права доступа к базе данных и активируйте плагин заново."

msgid "WooCommerce Invoice Printer needs its Composer dependencies for PDF and automatic printing. Browser printing remains available."
msgstr "Для PDF и автопечати нужны зависимости Composer. Печать в браузере остаётся доступной."

msgid "WooCommerce Invoice Printer requires WooCommerce 9.0 or newer."
msgstr "Для печати счетов WooCommerce требуется WooCommerce 9.0 или новее."

msgid "WooCommerce Invoice Printer requires WooCommerce to be installed and active."
msgstr "Для печати счетов WooCommerce требуется установленный и активный WooCommerce."

msgid "Working…"
msgstr "Обработка…"

msgid "You are not allowed to change these settings."
msgstr "У вас нет прав на изменение этих настроек."

msgid "You are not allowed to print invoices."
msgstr "У вас нет прав на печать счетов."

msgid "You are not allowed to view print jobs."
msgstr "У вас нет прав на просмотр заданий печати."

msgid "Your browser print dialog will open."
msgstr "Откроется диалог печати вашего браузера."

msgid "https://ildrm.com"
msgstr "https://ildrm.com"

