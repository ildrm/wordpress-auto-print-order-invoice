msgstr "Բացել տեղային փորձնական էջը"

#: src/Admin/AdminPage.php:137
msgid "For orders, choose Browser print dialog when printing an invoice or a bulk selection."
msgstr "Պատվերների համար մեկ հաշիվ կամ մի քանի ընտրված պատվերներ տպելիս ընտրեք զննարկիչի տպման երկխոսությունը։"

#: src/Admin/AdminPage.php:137
msgid "Local printers are selected in the browser print dialog and do not appear in the PrintNode list below. If a printer is missing from the dialog, install it in your operating system first."
msgstr "Տեղային տպիչներն ընտրվում են զննարկիչի տպման երկխոսությունում և չեն ցուցադրվում ստորև բերված PrintNode ցանկում։ Եթե տպիչը բացակայում է երկխոսությունում, նախ այն տեղադրեք օպերացիոն համակարգում։"

#: src/Admin/AdminPage.php:139
