#: src/Admin/AdminPage.php:142
msgid "PrintNode printers"
msgstr "PrintNode տպիչներ"

#: src/Admin/AdminPage.php:142
msgid "This list only contains printers shared by the PrintNode client on your account. Install and sign in to that client on the printer's computer, then refresh the list."
msgstr "Այս ցանկը պարունակում է միայն ձեր հաշվի PrintNode ծրագրի տրամադրած տպիչները։ Տեղադրեք ծրագիրը տպիչին միացված համակարգչում, մուտք գործեք ձեր հաշիվ և թարմացրեք ցանկը։"

