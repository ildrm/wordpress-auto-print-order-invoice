msgstr "Տեղային տպիչ (առանց API բանալու)"

#: src/Admin/AdminPage.php:137
msgid "Use a printer installed on this computer through your browser. No PrintNode account or API key is needed."
msgstr "Զննարկիչի միջոցով օգտագործեք այս համակարգչում տեղադրված տպիչը։ PrintNode հաշիվ կամ API բանալի անհրաժեշտ չէ։"

#: src/Admin/AdminPage.php:137
msgid "Open the test page, click Print, and choose your printer in the browser dialog."
msgstr "Բացեք փորձնական էջը, սեղմեք «Տպել» և զննարկիչի տպման երկխոսությունում ընտրեք ձեր տպիչը։"

#: src/Admin/AdminPage.php:137
