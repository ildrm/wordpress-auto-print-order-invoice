#: src/Admin/AdminPage.php:127
msgid "Automatic printing runs through PrintNode and needs its client on the printer's computer. Local browser printing requires you to confirm the print dialog."
msgstr "Ավտոմատ տպագրությունն աշխատում է PrintNode-ի միջոցով և պահանջում է դրա ծրագիրը տպիչին միացված համակարգչում։ Զննարկիչով տեղային տպագրության համար պետք է հաստատեք տպման երկխոսությունը։"

#: src/Admin/AdminPage.php:137
